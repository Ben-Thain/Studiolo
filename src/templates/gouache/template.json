   "sectionId": "s_22",
   "type": "text",
   "name": "Bio",
   "content": {
    "text": "I studied illustration in Falmouth and have painted for a living since 2017. Most of my work starts as small studies from life — fruit from the market, birds in the park, flowers from the allotment — which I then paint again, larger, for the page.\n\nI work with art directors, editors and small brands, usually on a few projects at a time.",
    "fontFamily": "Inter",
    "fontSize": 18,
    "fontWeight": 400,
    "align": "left",
    "sample": true
   },
   "sortOrder": 2
